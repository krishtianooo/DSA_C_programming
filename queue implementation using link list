#include <stdio.h>
#include <stdlib.h>

struct node
{
    int data;
    struct node *next;
};

struct node *F = NULL, *R =NULL;

int Dequeue(){
    int x = -1;
    struct node *p;

    if(F==NULL){
        printf("Q is empty\n");
    }
    else{
        p=F;
        F=F->next;
        x=p->data;
        free(p);
        p=NULL;

        if (F==NULL)
        {
            R==NULL;
        }
    }
    return x;
}
void Enqueue(int y){
    struct node *new;
    new = (struct node*)malloc(sizeof(struct node));

    if(new == NULL){
        printf("Memory allocation failded\n");
        return;
    }
    new ->data =y;
    new ->next = NULL;

    if(F==NULL){
        F=R=new;
    }else{
        R->next=new;
        R=new;
    }
}
void main(){
    Enqueue(10);
    Enqueue(20);
    Enqueue(30);

    printf("Deleted element is %d\n", Dequeue());
    printf("Deleted element is %d\n",Dequeue());
}
